        "options": [
          "رخيصة الثمن",
          "تتواجد حرة في الطبيعة",
          "سهلة الذوبان في الماء",
          "مغناطيسية"
        ],
        "explain": "الفلزات الأقل نشاطًا تتواجد حرة في الطبيعة، بخلاف الفلزات الأكثر نشاطًا التي تتواجد متحدة في مركبات."
      },
      {
        "correct": 0,
        "question": "خام البوكسايت يُستعمل لاستخلاص:",
        "options": [
          "الألمنيوم",
          "الحديد",
          "النحاس",
          "الذهب"
        ],
        "explain": "البوكسايت هو الخام الرئيسي لاستخلاص الألمنيوم منه، بعد تنقيته بإذابته في هيدروكسيد الصوديوم."
      },
      {
        "correct": 3,
        "question": "سبائك الطور الواحد تتكون من حبيبات:",
        "options": [
          "غازية فقط",
          "مختلفة تمامًا لا تمتزج",
          "سائلة دائمًا",
          "ذات تركيب متشابه يذوب فيها فلز في آخر"
        ],
        "explain": "تتكون سبائك الطور الواحد من حبيبات ذات تركيب متشابه، يذوب فيها فلز في فلز آخر، مثل سبيكة النحاس والنيكل."
      },
      {
        "correct": 1,
        "question": "سبيكة اللحام القلوي (رصاص وقصدير) تُصنع بالطريقة:",
        "options": [
          "المباشرة",
          "غير المباشرة ذات المرحلة الواحدة",
          "غير المباشرة ذات المرحلتين",
          "التحليل الكهربائي"
        ],
        "explain": "تُصنع سبيكة اللحام القلوي بالطريقة غير المباشرة ذات المرحلة الواحدة: يُصهر الرصاص أولًا ثم يُذاب فيه القصدير."
      }
    ]
  },
  "summary": {
    "heading": "📋 ملخص الفصل الثامن",
    "items": [
      "تتواجد الفلزات بصفة رئيسية في الزمرتين الأولى والثانية والفلزات الانتقالية، وتمتاز بكثافة وانصهار عاليين، وقابلية للطرق والسحب، والتوصيل الحراري والكهربائي.",
      "سلسلة النشاط ترتّب الفلزات من الأكثر نشاطًا إلى الأقل، وتحدد طريقة الاستخلاص المناسبة (تحليل كهربائي، صهر مع الكوك، أو تسخين بسيط).",
      "يجب تركيز الخامات الرديئة قبل الاستخلاص، كما في تنقية البوكسايت لاستخلاص الألمنيوم وتعويم الزبد لتركيز خام النحاس.",
      "السبيكة خليط من فلز أساس وعناصر أخرى، اكتشفها الإنسان منذ عصور ما قبل التاريخ، وأول سبيكة صنعها هي البرونز.",
      "تُصنَّف السبائك إلى طور واحد ومتعددة الأطوار، وتُصنع بالطريقة المباشرة أو غير المباشرة (مرحلة واحدة أو مرحلتين).",
      "تُستعمل السبائك في مجالات صناعية وطبية وإنشائية واسعة، ومنها سبائك مستعملة في البيئة العراقية كالنقود المعدنية وسبيكة الرصاص والفولاذ المقاوم للصدأ."
    ]
  },
