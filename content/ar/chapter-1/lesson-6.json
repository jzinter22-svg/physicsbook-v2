      "sectionId": "content",
      "sectionNavLabel": "💡 الشرح"
    },
    {
      "type": "formula",
      "id": null,
      "html": "$$ I = mr^2 \\qquad \\text{...(16)} $$\n      <p style=\"margin:.6rem 0 0;font-size:.95rem\">ووحدات عزم القصور الذاتي: \\(\\text{kg}\\cdot\\text{m}^2\\).</p>",
      "sectionGroup": 1,
      "sectionId": null,
      "sectionNavLabel": null
